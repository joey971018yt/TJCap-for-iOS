#include <winver.h>
#include "../../include/ios_vcam/app_resource.h"

IDI_APP_MAIN_ICON ICON "../../assets/app_icon.ico"

#ifndef _MSC_VER
1 24 "ios_vcam_gui.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION IOS_VCAM_VER_MAJOR,IOS_VCAM_VER_MINOR,IOS_VCAM_VER_PATCH,IOS_VCAM_VER_BUILD
 PRODUCTVERSION IOS_VCAM_VER_MAJOR,IOS_VCAM_VER_MINOR,IOS_VCAM_VER_PATCH,IOS_VCAM_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "CompanyName", "iOS USB Capture Project"
            VALUE "FileDescription", "iOS USB Capture Card App (2K+ Adaptive Control Center)"
            VALUE "FileVersion", IOS_VCAM_VER_STR
            VALUE "InternalName", "ios_vcam_gui"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "ios_vcam_gui.exe"
            VALUE "ProductName", "iOS USB Capture Card"
            VALUE "ProductVersion", IOS_VCAM_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
